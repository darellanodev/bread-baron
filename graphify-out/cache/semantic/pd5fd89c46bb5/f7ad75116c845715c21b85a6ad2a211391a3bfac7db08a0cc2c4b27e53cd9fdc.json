{"nodes": [{"id": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_lg_breakpoint_strategy", "label": "lg (1024px) Breakpoint Strategy", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 3-panel layout needs ~1024px to display comfortably: below lg the layout stacks vertically, at or above lg the desktop layout stays unchanged. The md (768px) breakpoint was judged too narrow for the 3-panel layout and a custom breakpoint unnecessary complexity."}, {"id": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_vertical_stacking_gamescreen", "label": "Vertical Stacking of GameScreen Panels on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "flex-col on mobile with flex-row on desktop is the simplest approach requiring no JavaScript; vertical scrolling is natural on touch devices. Tabs and drawers were rejected as over-engineered."}, {"id": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_conditional_visibility_hidden_block", "label": "Conditional Visibility via hidden/block Utilities", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Date stat and pause button text are redundant on small screens; hiding them with Tailwind hidden/lg:block reclaims space without losing functionality, while the icon-only pause button stays usable."}, {"id": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_industrymap_horizontal_scroll", "label": "IndustryMap Horizontal Scroll Container on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 5-stage map uses fixed w-32 stages; wrapping it in overflow-x-auto is the minimal change that preserves the desktop layout instead of restructuring the component. Risk: horizontal scroll may be undiscoverable, mitigated by visible stage cues."}, {"id": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_flexible_modal_dimensions", "label": "Flexible Modal Heights (h-auto max-h-80vh)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed heights like h-[600px] cause overflow or wasted space on small screens; h-auto adapts to content while max-h-[80vh] keeps the modal inside the viewport."}], "edges": [{"source": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_lg_breakpoint_strategy", "target": "openspec_changes_archive_2026_08_27_responsive_adaptation_specs_responsive_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_vertical_stacking_gamescreen", "target": "openspec_changes_archive_2026_08_27_responsive_adaptation_specs_responsive_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_conditional_visibility_hidden_block", "target": "openspec_changes_archive_2026_08_27_responsive_adaptation_specs_responsive_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_industrymap_horizontal_scroll", "target": "openspec_changes_archive_2026_08_27_responsive_adaptation_specs_responsive_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_08_27_responsive_adaptation_design_flexible_modal_dimensions", "target": "openspec_changes_archive_2026_08_27_responsive_adaptation_specs_responsive_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "responsive_lg_adaptation", "label": "Responsive lg-Breakpoint Adaptation Decisions", "nodes": ["openspec_changes_archive_2026_08_27_responsive_adaptation_design_lg_breakpoint_strategy", "openspec_changes_archive_2026_08_27_responsive_adaptation_design_vertical_stacking_gamescreen", "openspec_changes_archive_2026_08_27_responsive_adaptation_design_conditional_visibility_hidden_block", "openspec_changes_archive_2026_08_27_responsive_adaptation_design_industrymap_horizontal_scroll", "openspec_changes_archive_2026_08_27_responsive_adaptation_design_flexible_modal_dimensions", "openspec_changes_archive_2026_08_27_responsive_adaptation_specs_responsive_layout_capability"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "openspec/changes/archive/2026-08-27-responsive-adaptation/design.md"}]}