{"nodes": [{"id": "openspec_changes_archive_2026_07_15_continue_button_design_continue_button_design", "label": "Continue Button design document", "file_type": "document", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_use_has_save", "label": "useHasSave hook (src/hooks/useHasSave.ts)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Decision 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synchronous single localStorage read + JSON parse on mount is cheap and used in one place, so a self-contained hook beats a context/provider; validating the parsed shape (not just key existence) keeps the Continue button hidden for corrupted saves."}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_load_from_storage", "label": "loadFromStorage() utility (src/utils/loadFromStorage.ts)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Decision 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loading is a one-shot action triggered by a click, not reactive state, so a plain function is simpler and more testable than a hook; failures return false so callers can fall back to the normal flow."}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_welcome_button", "label": "WelcomeButton component (src/features/welcome/layout/WelcomeButton.tsx)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Decision 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hasSave plus an onContinue callback lets one component render either the two-button layout or the original single Next button, keeping existing behaviour unchanged when no save exists."}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_welcome_screen", "label": "WelcomeScreen component (src/features/welcome/WelcomeScreen.tsx)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Context", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_save_key", "label": "SAVE_KEY constant (src/types/saveTypes.ts)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Context", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_use_auto_save", "label": "useAutoSave hook (5s localStorage auto-save)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Context / Risks", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_save_data", "label": "SaveData interface (version, savedAt, state)", "file_type": "code", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Context", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_changes_archive_2026_07_15_continue_button_design_save_game_change", "label": "save-game change (auto-save origin)", "file_type": "document", "source_file": "openspec/changes/archive/2026-07-15-continue-button/design.md", "source_location": "Context", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openspec_changes_archive_2026_07_15_continue_button_design_continue_button