{"nodes": [{"id": "openspec_changes_archive_2026_07_15_save_game_design_zustand_game_store", "label": "Zustand gameStore Single Serializable Store", "file_type": "concept", "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All game state lives in one Zustand store (gameStore.ts) as serializable data plus action functions; only the serializable fields need persistence, since actions are defined in code."}, {"id": "openspec_changes_archive_2026_07_15_save_game_design_custom_hook_over_persist_middleware", "label": "Custom useAutoSave Hook Instead of Zustand Persist Middleware", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "zustand/middleware/persist serializes the entire store including ~15 non-serializable action functions, makes the save format opaque, and offers no beforeunload safety net; a custom hook gives explicit field selection, a versioned envelope, and unload handling. Persistent Zustand middleware was explicitly rejected."}, {"id": "openspec_changes_archive_2026_07_15_save_game_design_explicit_pick_serialization", "label": "Explicit Pick of Saveable GameState Fields", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An explicit Pick of every saveable field is self-documenting and type-safe, and fails at compile time if a store field is added without updating the save type, unlike runtime JSON.stringify plus filtering."}, {"id": "openspec_changes_archive_2026_07_15_save_game_design_save_interval_aligned_game_tick", "label": "5-Second Save Interval Aligned With Game Tick", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SAVE_INTERVAL_MS = 5000 matches DAY_DURATION_MS so every save reflects a meaningful tick state change with no redundant writes; the beforeunload handler covers the gap between intervals."}, {"id": "openspec_changes_archive_2026_07_15_save_game_design_versioned_save_envelope", "label": "Versioned SaveData Envelope Format", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The version field enables future migration and load-time validation if the state shape changes; savedAt provides last-saved UI metadata and debugging aid at minimal overhead."}, {"id": "openspec_changes_archive_2026_07_15_save_game_design_always_active_autosave_mount", "label": "Always-Active Auto-Save Mount in App.tsx", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calling useAutoSave() unconditionally in App.tsx saves default state even before play begins, so there is always something to restore once load is implemented, and avoids conditional mount logic."}], "edges": [{"source": "openspec_changes_archive_2026_07_15_save_game_design_custom_hook_over_persist_middleware", "target": "openspec_changes_archive_2026_07_15_save_game_specs_auto_save_useautosave_hook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_15_save_game_design_explicit_pick_serialization", "target": "openspec_changes_archive_2026_07_15_save_game_specs_auto_save_savedata_envelope", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_15_save_game_design_explicit_pick_serialization", "target": "openspec_changes_archive_2026_07_15_save_game_design_zustand_game_store", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_15_save_game_design_save_interval_aligned_game_tick", "target": "openspec_changes_archive_2026_07_15_save_game_specs_auto_save_useautosave_hook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_15_save_game_design_versioned_save_envelope", "target": "openspec_changes_archive_2026_07_15_save_game_specs_auto_save_savedata_envelope", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_15_save_game_design_always_active_autosave_mount", "target": "openspec_changes_archive_2026_07_15_save_game_specs_auto_save_useautosave_hook", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_15_save_game_design_always_active_autosave_mount", "target": "openspec_specs_auto_save_spec", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-15-save-game/design.md", "source_location": null, "weight": 1.0}], "hyperedges": []}