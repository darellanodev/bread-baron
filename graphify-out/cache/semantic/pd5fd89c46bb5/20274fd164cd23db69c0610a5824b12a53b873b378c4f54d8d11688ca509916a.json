{"nodes": [{"id": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_hide_title_block_mobile", "label": "Hide Entire HeaderTitle Block on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The title (icon plus text, ~200px) is decorative; players already know the game they are playing. Removing both icon and text frees space for functional elements, and keeping only the icon was rejected as not worth its footprint."}, {"id": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_pause_button_min_width_removal", "label": "Pause Button min-width Removal on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pause button text is already hidden on mobile, leaving an icon-only button (~32px); min-w-[84px] was forcing 84px of empty width, so the button should shrink to natural content width. A separate icon-only button variant was rejected as overkill."}, {"id": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_settings_button_mobile_shrink", "label": "Settings Button Shrinks From 40px to 32px on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "40px is oversized for a secondary action on mobile; 32px saves space while keeping a usable tap target. Known risk: 32px is below Apple's 44px HIG guideline, mitigated because settings is low-frequency during gameplay."}, {"id": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_stat_typography_reduction", "label": "Stat Value Font Reduction on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Smaller text (text-xs) lets stat pills narrow while remaining readable, since money and baked-count values are short numeric strings."}, {"id": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_header_gap_reduction", "label": "Header Container Gap Reduction on Mobile", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 32px gap between stats and actions is wasteful on mobile; 12px keeps visual separation while fitting more content in a 375px viewport."}], "edges": [{"source": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_hide_title_block_mobile", "target": "openspec_changes_archive_2026_08_27_header_responsive_mobile_specs_header_mobile_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_pause_button_min_width_removal", "target": "openspec_changes_archive_2026_08_27_header_responsive_mobile_specs_header_mobile_layout_capability", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-08-27-header-responsive-mobile/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_08_27_header_responsive_mobile_design_settings_button_mobile_shrink", "target": "openspec_changes_archive_2026_08_27_header_responsive